{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalNote",
  "version": "0.3.4",
  "identifier": "com.sanzero.localnote",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LocalNote — private neural notes",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true,
        "label": "main",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; media-src 'self' blob:",
      "capabilities": [
        "main-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
